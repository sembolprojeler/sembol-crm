rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // EKLENDİ: Fiyat belgesi ve fiyat geçmişi yalnızca sunucudan (/api/fiyatlar,
    // Admin SDK) yazılır. Admin SDK bu kurallara takılmaz, tarayıcılar takılır.
    function fiyatKorumali(yol) {
      return string(yol).matches('.*artifacts/[^/]+/public/data/(ayarlar/fiyatTablosu|fiyat_gecmisi/[^/]+)');
    }

    match /{document=**} {
      // Sadece sisteme giriş yapmış (auth olmuş) 30 personeliniz verileri okuyabilir ve yazabilir.
      // Dışarıdan hiç kimse (giriş yapmayanlar) veriye erişemez.
      allow read: if request.auth != null;
      allow write: if request.auth != null && !fiyatKorumali(document);   // DEĞİŞTİ
    }
  }
}
