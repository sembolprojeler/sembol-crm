rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fiyat belgesi, fiyat geçmişi ve WhatsApp konuşmaları / durum belgeleri
    // yalnızca sunucudan (Admin SDK: /api/fiyatlar, /api/whatsapp-webhook, /api/whatsapp-send) yazılır.
    function sunucuKorumali(yol) {
      return string(yol).matches('.*artifacts/[^/]+/public/data/(ayarlar/fiyatTablosu|fiyat_gecmisi/[^/]+|whatsapp_conversations/.+|whatsapp_durum/[^/]+)');
    }

    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !sunucuKorumali(document);
    }
  }
}
