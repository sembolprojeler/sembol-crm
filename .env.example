# Sembol CRM — sunucu ortam değişkenleri (Vercel → Project Settings → Environment Variables)
# Değerler BURAYA YAZILMAZ. Bu dosya yalnızca liste. VITE_ öneki olanlar tarayıcıya gider;
# aşağıdakilerin HİÇBİRİ VITE_ ile başlamaz (yalnızca sunucu).

# --- Firebase (mevcut) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_APP_ID=

# --- WhatsApp Cloud API (api/whatsapp-webhook.js, api/whatsapp-send.js) ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Numara → marka (JSON, ZORUNLU). Marka gelen mesajın metadata.phone_number_id'sinden belirlenir;
# eşlemede olmayan numaranın mesajı kaydedilir ama bot cevap vermez. Değerler: "sembolevdeneve" | "depoevim"
#   {"<0850 phone_number_id>":"depoevim","<0216 phone_number_id>":"sembolevdeneve"}
WHATSAPP_NUMARALAR=
# isteğe bağlı: bir numara başka bir Meta işletmesindeyse o numaranın token'ı
# WHATSAPP_TOKEN_<phone_number_id>=
WHATSAPP_GUNLUK_BOT_CEVABI=
WHATSAPP_GRAPH_VERSION=
# Medya yükleme (boşsa CRM'in bugünkü ucu: https://www.sembolevdeneve.com/crm/upload.php → crm/uploads/)
MEDYA_YUKLEME_URL=
MEDYA_DOSYA_KOKU=
# Cloudflare geçiş kuralı için gizli değer → upload.php isteğine "X-Medya-Anahtari" başlığı (loglanmaz)
MEDYA_YUKLEME_ANAHTARI=
WHATSAPP_BIRLESTIRME_MS=
WHATSAPP_CUMARTESI=
WHATSAPP_GUNLUK_GOOGLE=
WHATSAPP_BOT_KAPALI=

# --- Yapay zeka (SEMBO Asistan) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Km / Google (mevcut) ---
GOOGLE_MAPS_API_KEY=
MESAFE_SITE_IP_SAATLIK=
MESAFE_SITE_GUNLUK_GOOGLE=
MESAFE_SITE_EK_ORIGINS=

# --- Diğer (mevcut) ---
ALLOWED_ORIGINS=
OPENAI_PIXEL_ID=
OPENAI_CONVERSIONS_KEY=
OPENAI_CAPI_TEST=
OPENAI_DONUSUM_SITELERI=
