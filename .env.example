# Sembol CRM — sunucu ortam değişkenleri (Vercel → Project Settings → Environment Variables)
# Değerler BURAYA YAZILMAZ. Bu dosya yalnızca liste. VITE_ öneki olanlar tarayıcıya gider;
# aşağıdakilerin HİÇBİRİ VITE_ ile başlamaz (yalnızca sunucu).

# --- Firebase (mevcut) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_APP_ID=

# --- WhatsApp Cloud API (api/whatsapp-webhook.js, api/whatsapp-send.js) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# isteğe bağlı
# Hat → marka (JSON). Boşsa WHATSAPP_PHONE_NUMBER_ID tek hat = DepoEvim (0850). Sembol numarası gelince:
# [{"phoneNumberId":"<0850 id>","marka":"depoevim","tokenEnv":"WHATSAPP_TOKEN","ad":"0850 441 78 86","eskiKimlik":true},
#  {"phoneNumberId":"<sembol id>","marka":"sembol","tokenEnv":"WHATSAPP_TOKEN_SEMBOL","ad":"Sembol"}]
WHATSAPP_HATLAR=
WHATSAPP_GUNLUK_BOT_CEVABI=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_BIRLESTIRME_MS=
WHATSAPP_CUMARTESI=
WHATSAPP_GUNLUK_GOOGLE=
WHATSAPP_BOT_KAPALI=

# --- Yapay zeka (SEMBO Asistan) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Km / Google (mevcut) ---
GOOGLE_MAPS_API_KEY=
MESAFE_SITE_IP_SAATLIK=
MESAFE_SITE_GUNLUK_GOOGLE=
MESAFE_SITE_EK_ORIGINS=

# --- Diğer (mevcut) ---
ALLOWED_ORIGINS=
OPENAI_PIXEL_ID=
OPENAI_CONVERSIONS_KEY=
OPENAI_CAPI_TEST=
OPENAI_DONUSUM_SITELERI=
