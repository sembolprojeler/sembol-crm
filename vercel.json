{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "qr" }],
      "missing": [{ "type": "query", "key": "qrt" }],
      "destination": "/api/qr-yonlendir",
      "statusCode": 302
    }
  ],
  "functions": {
    "api/whatsapp-webhook.js": { "maxDuration": 60 },
    "api/whatsapp-send.js": { "maxDuration": 60 }
  }
}
